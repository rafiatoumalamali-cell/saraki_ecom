APP_NAME=SARAKI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://saraki.test
APP_TIMEZONE=Africa/Accra

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saraki_local
DB_USERNAME=saraki
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@saraki.test"
MAIL_FROM_NAME="${APP_NAME}"

STORE_NAME=SARAKI
STORE_CURRENCY=GHS
STORE_ADMIN_EMAIL=admin@saraki.test
ORDER_NUMBER_PREFIX=SRK
ORDER_EXPIRY_MINUTES=30

# Paystack: TEST keys only outside production. Never commit real keys.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CHANNELS=card,mobile_money

VITE_APP_NAME="${APP_NAME}"
